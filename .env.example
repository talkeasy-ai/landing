# Environment variables for Talkeasy Landing Page

# Mailchimp waitlist (used by api/mailchimp.js — set these in Vercel project settings)
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_SERVER=us21  # optional: defaults to the suffix of the API key

# API Configuration (if needed)
# VITE_API_URL=https://api.example.com

# Analytics (if needed)
# VITE_ANALYTICS_ID=

# Feature Flags (if needed)
# VITE_ENABLE_BETA_FEATURES=false
